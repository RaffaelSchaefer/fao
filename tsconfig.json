{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"jsx": "preserve",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"types": ["vite/client", "node"],
		"noEmit": true,
		"checkJs": false,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": [
		"src/main.ts",
		"src/env.d.ts",
		"src/common/**/*.ts",
		"src/public/**/*.ts",
		"src/**/*.vue",
		"vite.config.ts",
		"playwright.config.ts",
		"test/**/*.ts"
	],
	"exclude": ["node_modules", "dist", "src/server"]
}
