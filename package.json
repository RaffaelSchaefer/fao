{
	"name": "fake-artist-online",
	"version": "1.0.0",
	"engines": {
		"node": ">=22.18.0"
	},
	"description": "",
	"type": "module",
	"main": "dist/server/server.js",
	"scripts": {
		"clean": "rm -rf dist/ .vite/ playwright-report/ test-results/",
		"dev": "concurrently -k \"tsx src/server/server.js\" \"vp dev\"",
		"build": "tsc -p tsconfig.server.json && vp build",
		"build:server": "tsc -p tsconfig.server.json",
		"start": "node ./dist/server/server.js",
		"test": "vp test && playwright test",
		"test:e2e": "playwright test",
		"check": "tsc -p tsconfig.json --noEmit",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"author": "Gideon W",
	"license": "ISC",
	"dependencies": {
		"ajv": "^6.10.0",
		"compression": "^1.7.4",
		"csv-parse": "^6.1.0",
		"dotenv": "^6.2.0",
		"express": "^4.16.3",
		"lodash": "^4.17.21",
		"normalize.css": "^8.0.1",
		"socket.io": "^4.8.1",
		"socket.io-client": "^4.8.1",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"@types/node": "^22.13.10",
		"@vitejs/plugin-vue": "^6.0.1",
		"@voidzero-dev/vite-plus-core": "latest",
		"concurrently": "^9.1.2",
		"@playwright/test": "^1.52.0",
		"sass": "^1.98.0",
		"tsx": "^4.19.2",
		"typescript": "^5.8.3",
		"vite-plus": "latest",
		"vitest": "npm:@voidzero-dev/vite-plus-test@latest",
		"vue-tsc": "^2.2.8"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@latest"
	}
}
