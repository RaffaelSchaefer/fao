{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"rootDir": "src",
		"outDir": "dist",
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src/common/**/*", "src/server/**/*"],
	"exclude": ["src/public/**/*", "dist/**/*", "test/**/*"]
}
